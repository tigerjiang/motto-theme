{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<section class="hiw-section hiw-enjoy">
  <div class="hiw-container">
    <h2 class="hiw-title hiw-enjoy__title">{{ section.settings.heading | escape }}</h2>
    <div class="hiw-enjoy__grid">
      {%- for block in section.blocks -%}
        <div class="hiw-media hiw-enjoy__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360, 540, 750, 1000, 1400, 1600, 1800', sizes: '(min-width: 1920px) 788px, (min-width: 750px) 45vw, calc(100vw - 32px)', alt: block.settings.image_alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hiw-placeholder placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="hiw-enjoy__button">
        {% render 'button',
          btn_label: section.settings.button_label,
          btn_link: section.settings.button_link,
          btn_style: 'primary',
          add_classes: 'hiw-enjoy__button-link focus-inset'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Enjoy hands-free",
  "tag": "section",
  "class": "hiw-enjoy-section",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enjoy your perfectly cooked flavors—effortless, automated, and hands-free." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [{
    "type": "image", "name": "Image",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Brisk It cooking experience" }
    ]
  }],
  "presets": [{ "name": "Enjoy hands-free", "blocks": [{"type":"image"},{"type":"image"}] }]
}
{% endschema %}
