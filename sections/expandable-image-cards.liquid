{{ 'section-expandable-image-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-expandable-image-cards.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} .expandable-image-cards {
    --expandable-cards-background: {{ section.settings.background_color }};
    --expandable-cards-heading: {{ section.settings.heading_color }};
    --expandable-cards-accent: {{ section.settings.accent_color }};
    --expandable-cards-pill-background: {{ section.settings.label_background | color_modify: 'alpha', 0.5 }};
    --expandable-cards-pill-text: {{ section.settings.label_color }};
  }

  #shopify-section-{{ section.id }} .expandable-image-cards__eyebrow {
    font-size: 16px;
  }
{%- endstyle -%}

<expandable-image-cards class="expandable-image-cards" data-default-index="0">
  <div class="expandable-image-cards__inner">
    <div class="expandable-image-cards__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="expandable-image-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="expandable-image-cards__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="expandable-image-cards__intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="expandable-image-cards__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign image_loading = 'lazy'
            if forloop.first
              assign image_loading = 'eager'
            endif
          -%}
          <div
            class="expandable-image-cards__card{% if forloop.first %} is-active{% endif %}"
            role="button"
            tabindex="0"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
            data-card
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="expandable-image-cards__media" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: image_loading,
                    widths: '360, 540, 720, 960, 1200, 1600, 2000, 2400',
                    sizes: '(min-width: 990px) 60vw, (min-width: 750px) 70vw, calc(100vw - 40px)',
                    class: 'expandable-image-cards__image',
                    alt: ''
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'expandable-image-cards__placeholder placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="expandable-image-cards__overlay"></div>

            <div class="expandable-image-cards__content">
              <div class="expandable-image-cards__details">
                {%- if block.settings.title != blank -%}
                  <h3 class="expandable-image-cards__card-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="expandable-image-cards__card-description rte">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

              {%- if block.settings.label != blank -%}
                <span class="expandable-image-cards__label">
                  <svg class="expandable-image-cards__label-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M15.8 5.2A8 8 0 1 0 18.7 16M15.8 5.2V1.8M15.8 5.2h3.4M19 8.5v3.7M17.2 10.35h3.6"/>
                  </svg>
                  <span>{{ block.settings.label | escape }}</span>
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</expandable-image-cards>

{% schema %}
{
  "name": "Expandable image cards",
  "tag": "section",
  "class": "expandable-image-cards-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OPTIMIZE YOUR LIFE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Time. Better Food."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Set your taste. Brisk It AI handles the rest — autonomous cooking, healthier eating, and more time for living.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF9F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and text",
      "default": "#13294B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow",
      "default": "#E65C00"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Label background",
      "default": "#FFF8EA"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text",
      "default": "#13294B"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Health optimized"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Expanded title",
          "default": "Live Stronger"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Expanded description",
          "default": "<p>Set your health goals. Brisk It AI plans and cooks around them — so you fuel better, live stronger.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expandable image cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "Health optimized",
            "title": "Live Stronger",
            "text": "<p>Set your health goals. Brisk It AI plans and cooks around them — so you fuel better, live stronger.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Control anywhere",
            "title": "Stay Connected",
            "text": "<p>Monitor and control your cook from wherever life takes you.</p>"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Zero Thinking",
            "title": "Cook Effortlessly",
            "text": "<p>Let Brisk It handle the details while you enjoy more time around the table.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
