{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{% if section.settings.text_animation %}
  {{ 'component-heading-animations.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'split-type.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'hero.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  #shopify-section-{{ section.id }} .hero {
    --hero-eyebrow-color: {{ section.settings.eyebrow_color }};
    --hero-title-color: {{ section.settings.title_color }};
    --hero-text-color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

{%- render 'hero', mod_class: 'hero--title-large' -%}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Higher priority over the images"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image - Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image - Mobile",
      "info": "Optional."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge",
      "info": "Upload 2x size image to ensure it's retina"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Header"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Header color",
      "default": "#E87928"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#13294B"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "text_width",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large",
      "label": "Text width"
    },
    {
      "type": "header",
      "content": "Button first"
    },
    {
      "type": "text",
      "id": "button_first_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_first_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_first_style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" }
      ],
      "default": "primary",
      "label": "Button style"
    },
    {
      "type": "header",
      "content": "Button second"
    },
    {
      "type": "text",
      "id": "button_second_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_second_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "button_second_dot",
      "default": false,
      "label": "Show button dot"
    },
    {
      "type": "select",
      "id": "button_second_style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "tertiary", "label": "Tertiary" }
      ],
      "default": "secondary",
      "label": "Button style"
    },
    {
      "type": "header",
      "content": "Content animation"
    },
    {
      "type": "checkbox",
      "id": "text_animation",
      "default": true,
      "label": "Enable text animation"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "div", "label": "div" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" }
      ],
      "default": "h1"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "category": "Heroes"
    }
  ]
}
{% endschema %}
