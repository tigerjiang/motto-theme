{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
-%}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}

<div class="contact-form section-{{ section.id }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  <div class="container">
    <div class="contact-form__container contact-form__container--{{ section.settings.content_align }}">
      <div class="contact-form__inner">
        <div class="contact-form__wrapper">
          {%- if section.settings.heading != blank -%}
            {% assign heading_tag = section.settings.heading_tag %}
            <{{ heading_tag }} class="contact-form__title {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="contact-form__text">
              {{ section.settings.text }}
            </p>
          {%- endif -%}
          {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ 'templates.contact.form.post_success' | t }}
              </div>
            {%- elsif form.errors -%}
            {%- endif -%}
            {%- if section.settings.show_name_field -%}
              <div class="field field__name{% if section.settings.require_name_field %} field--with-error{% endif %}">
                <input
                  class="field__input focus-inset"
                  autocomplete="name"
                  type="text"
                  dir="ltr"
                  id="{{ form_id }}-name"
                  name="contact[{{ 'templates.contact.form.name' | t }}]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                  {% if section.settings.require_name_field %}
                    aria-required="true"
                    required
                  {% endif %}
                >
                <label
                  class="field__label"
                  for="{{ form_id }}-name"
                  placeholder="{{ 'templates.contact.form.name' | t }}"
                >
                  {{ 'templates.contact.form.name' | t }}
                </label>
              </div>
            {%- endif -%}
            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                dir="ltr"
                id="{{ form_id }}-email"
                class="field__input focus-inset"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="{{ form_id }}-email-error"
                {% else %}
                  aria-describedby="{{ form_id }}-email-client-error"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
                required
              >
              <label
                class="field__label"
                for="{{ form_id }}-email"
                placeholder="{{ 'templates.contact.form.email' | t }}"
              >
                {{ 'templates.contact.form.email' | t }}
              </label>
              {%- if form.errors contains 'email' -%}
                <small class="contact-form__field-error" id="{{ form_id }}-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
              <small
                class="contact-form__field-error contact-form__field-error--client"
                id="{{ form_id }}-email-client-error"
                hidden
              >
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">
                  {{- 'templates.contact.form.email_invalid' | t -}}
                </span>
              </small>
            </div>
            {%- if section.settings.show_phone_field -%}
              <div class="field{% if section.settings.require_phone_field %} field--with-error{% endif %}">
                <input
                  type="tel"
                  dir="ltr"
                  id="{{ form_id }}-phone"
                  class="field__input focus-inset"
                  autocomplete="tel"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'templates.contact.form.phone' | t }}"
                  {% if section.settings.require_phone_field %}
                    aria-required="true"
                    required
                  {% endif %}
                >
                <label
                  class="field__label"
                  for="{{ form_id }}-phone"
                  placeholder="{{ 'templates.contact.form.phone' | t }}"
                >
                  {{- 'templates.contact.form.phone' | t -}}
                </label>
              </div>
            {%- endif -%}
            {%- if section.settings.show_message_field -%}
              <div class="field">
                <textarea
                  dir="ltr"
                  id="{{ form_id }}-body"
                  class="text-area field__input focus-inset"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                  aria-required="true"
                  required
                >
                  {{- form.body -}}
                </textarea>
                <label
                  class="form__label field__label"
                  for="{{ form_id }}-body"
                  placeholder="{{ 'templates.contact.form.comment' | t }}"
                >
                  {{- 'templates.contact.form.comment' | t -}}
                </label>
              </div>
            {%- endif -%}
            {% content_for 'blocks' %}
            {%- if section.settings.privacy_policy_consent and shop.privacy_policy != blank -%}
              <div class="field field--checkbox field--with-error">
                <input
                  type="checkbox"
                  class="focus-inset"
                  name="terms"
                  id="{{ form_id }}-terms"
                  {% if form.errors contains 'terms' %}
                    aria-invalid="true"
                    aria-describedby="{{ form_id }}-terms-error"
                  {% else %}
                    aria-describedby="{{ form_id }}-terms-client-error"
                  {% endif %}
                  required
                >
                <label for="{{ form_id }}-terms">
                  <span>
                    {{ 'templates.contact.form.accept_terms' | t }}
                    <a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener noreferrer">
                      {{- shop.privacy_policy.title -}}
                    </a>
                  </span>
                </label>
                {%- if form.errors contains 'terms' -%}
                  <small class="contact-form__field-error" id="{{ form_id }}-terms-error">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      {{- 'templates.contact.form.terms_error' | t -}}
                    </span>
                  </small>
                {%- endif -%}
                <small
                  class="contact-form__field-error contact-form__field-error--client"
                  id="{{ form_id }}-terms-client-error"
                  hidden
                >
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    {{- 'templates.contact.form.terms_error' | t -}}
                  </span>
                </small>
              </div>
            {%- endif -%}
            <div class="contact-form__bottom">
              <button
                type="submit"
                class="button button--{{ section.settings.button_style }} button--primary-size focus-inset"
                data-button-text="{{ 'templates.contact.form.send' | t }}"
              >
                <span>{{ 'templates.contact.form.send' | t }}</span>
              </button>

              {% if section.settings.additional_text != blank %}
                <div class="contact-form__add-text">
                  {{ section.settings.additional_text }}
                </div>
              {% endif %}
            </div>
          {%- endform -%}
        </div>

        {% if section.settings.image != blank %}
          {% capture style %}
            {% if section.settings.image_ratio != 'adapt' %}
              --aspect-ratio: {{ section.settings.image_ratio }};
            {% elsif section.settings.image_ratio == 'adapt' %}
              --aspect-ratio: {{section.settings.image.aspect_ratio }};
            {% endif %}
          {% endcapture %}
          {% capture sizes %}
            (min-width: 750px) 600px, 
            calc(100vw - 20px)
          {% endcapture %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              loading: 'lazy',
              widths: '375, 600, 750, 990, 1200, 1400, 1600',
              class: 'contact-form__image',
              style: style,
              sizes: sizes
          }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "spaced-section contact-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "blocks": [
    {
      "type": "contact-custom-field"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:sections.contact-form.settings.content_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.contact-form.settings.content_align.options_1.label"
        },
        {
          "value": "center",
          "label": "t:sections.contact-form.settings.content_align.options_2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_options.header.content"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.contact-form.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.all.heading.tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "div",
          "label": "div"
        },
        {
          "value": "p",
          "label": "p"
        },
        {
          "value": "span",
          "label": "span"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text",
      "default": "t:sections.contact-form.settings.text.default",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "inline_richtext",
      "id": "additional_text",
      "default": "t:sections.contact-form.settings.additional_text.default",
      "label": "t:sections.contact-form.settings.additional_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.contact-form.settings.form_fields.header.content"
    },
    {
      "type": "checkbox",
      "id": "show_name_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_name_field.label"
    },
    {
      "type": "checkbox",
      "id": "require_name_field",
      "default": false,
      "label": "t:sections.contact-form.settings.require_name_field.label",
      "visible_if": "{{ section.settings.show_name_field }}"
    },
    {
      "type": "checkbox",
      "id": "show_phone_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_phone_field.label"
    },
    {
      "type": "checkbox",
      "id": "require_phone_field",
      "default": false,
      "label": "t:sections.contact-form.settings.require_phone_field.label",
      "visible_if": "{{ section.settings.show_phone_field }}"
    },
    {
      "type": "checkbox",
      "id": "show_message_field",
      "default": true,
      "label": "t:sections.contact-form.settings.show_message_field.label"
    },
    {
      "type": "checkbox",
      "id": "privacy_policy_consent",
      "default": false,
      "label": "t:sections.contact-form.settings.privacy_policy_consent.label",
      "info": "t:sections.contact-form.settings.privacy_policy_consent.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.header.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "16/9",
      "label": "t:sections.all.image.aspect_ratio.label",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.image.aspect_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.image.aspect_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.image.aspect_ratio.options__3.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.image.aspect_ratio.options__4.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.image.aspect_ratio.options__5.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.all.image.aspect_ratio.options__6.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.options__7.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
