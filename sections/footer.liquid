{{- 'section-footer.css' | asset_url | stylesheet_tag -}}

{%- assign footer_settings = section.settings -%}

<footer class="brisk-footer color-{{ section.settings.color_scheme }} background">
  <div class="brisk-footer__wrapper">
    <div class="brisk-footer__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img
          src="{{ 'brisk-footer-logo.svg' | asset_url }}"
          width="181"
          height="46"
          loading="lazy"
          alt="{{ shop.name | escape }}"
        >
      </a>
    </div>

    <div class="brisk-footer__body">
      <div class="brisk-footer__left">
        {%- if footer_settings.title != blank -%}
          <h2 class="brisk-footer__title">{{ footer_settings.title }}</h2>
        {%- endif -%}

        <div class="brisk-footer__newsletter">
          {%- if footer_settings.newsletter_title != blank -%}
            <h3 class="brisk-footer__newsletter-title">{{ footer_settings.newsletter_title }}</h3>
          {%- endif -%}

          {%- form 'customer', class: 'brisk-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.errors -%}
              <div class="brisk-footer__form-message brisk-footer__form-message--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="brisk-footer__form-message brisk-footer__form-message--success" role="status">
                Thanks for subscribing!
              </p>
            {%- endif -%}

            <div class="brisk-footer__field-wrap">
              <label class="visually-hidden" for="FooterNewsletter-{{ section.id }}">Email</label>
              <input
                id="FooterNewsletter-{{ section.id }}"
                class="brisk-footer__field"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ footer_settings.newsletter_placeholder | default: 'Enter your email here' | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button class="brisk-footer__submit" type="submit" aria-label="Subscribe">
                <span aria-hidden="true"></span>
              </button>
            </div>
          {%- endform -%}
        </div>

        <div class="brisk-footer__social-row">
          {%- if footer_settings.link_text != blank and footer_settings.link_url != blank -%}
            <a
              class="brisk-footer__instagram-link"
              href="{{ footer_settings.link_url }}"
              target="_blank"
              rel="noopener"
            >
              {{ footer_settings.link_text }}
            </a>
          {%- endif -%}

          {%- unless footer_settings.hide_socials -%}
            <ul class="brisk-footer__socials" role="list">
              {%- if footer_settings.social_instagram_link != blank -%}
                <li>
                  <a href="{{ footer_settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
                    {%- render 'icon-instagram' -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if footer_settings.social_facebook_link != blank -%}
                <li>
                  <a href="{{ footer_settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
                    {%- render 'icon-facebook' -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if footer_settings.social_youtube_link != blank -%}
                <li>
                  <a href="{{ footer_settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">
                    {%- render 'icon-youtube' -%}
                  </a>
                </li>
              {%- endif -%}
              {%- if footer_settings.social_tiktok_link != blank -%}
                <li>
                  <a href="{{ footer_settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">
                    {%- render 'icon-tiktok' -%}
                  </a>
                </li>
              {%- endif -%}
            </ul>
          {%- endunless -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="brisk-footer__categories">
          {%- for block in section.blocks -%}
            <div class="brisk-footer__category" {{ block.shopify_attributes }}>
              {%- if block.settings.category_title != blank -%}
                {%- if block.settings.category_link_url != blank -%}
                  <a class="brisk-footer__category-title" href="{{ block.settings.category_link_url }}">
                    {{ block.settings.category_title }}
                  </a>
                {%- else -%}
                  <h3 class="brisk-footer__category-title">{{ block.settings.category_title }}</h3>
                {%- endif -%}
              {%- endif -%}

              <ul class="brisk-footer__category-links" role="list">
                {%- for index in (1..6) -%}
                  {%- assign link_text_key = 'link_text_' | append: index -%}
                  {%- assign link_url_key = 'link_url_' | append: index -%}
                  {%- if block.settings[link_text_key] != blank -%}
                    <li>
                      <a href="{{ block.settings[link_url_key] | default: '#' }}">
                        {{ block.settings[link_text_key] }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="brisk-footer__bottom">
      {%- if footer_settings.menu != blank -%}
        <nav class="brisk-footer__nav" aria-label="Footer">
          <ul role="list">
            {%- for link in footer_settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if footer_settings.copyright != blank -%}
        <p class="brisk-footer__copyright">{{ footer_settings.copyright }}</p>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Brisk footer",
  "class": "section-brisk-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Instagram link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Instagram link URL"
    },
    {
      "type": "checkbox",
      "id": "hide_socials",
      "label": "Hide socials",
      "default": false
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_youtube_link",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "TikTok URL"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Bottom menu"
    },
    {
      "type": "textarea",
      "id": "copyright",
      "label": "Copyright"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_title",
      "label": "Newsletter title"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "category",
      "name": "Navigation category",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Category title",
          "default": "Category title"
        },
        {
          "type": "url",
          "id": "category_link_url",
          "label": "Category link"
        },
        {
          "type": "text",
          "id": "link_text_1",
          "label": "Link 1 text"
        },
        {
          "type": "url",
          "id": "link_url_1",
          "label": "Link 1 URL"
        },
        {
          "type": "text",
          "id": "link_text_2",
          "label": "Link 2 text"
        },
        {
          "type": "url",
          "id": "link_url_2",
          "label": "Link 2 URL"
        },
        {
          "type": "text",
          "id": "link_text_3",
          "label": "Link 3 text"
        },
        {
          "type": "url",
          "id": "link_url_3",
          "label": "Link 3 URL"
        },
        {
          "type": "text",
          "id": "link_text_4",
          "label": "Link 4 text"
        },
        {
          "type": "url",
          "id": "link_url_4",
          "label": "Link 4 URL"
        },
        {
          "type": "text",
          "id": "link_text_5",
          "label": "Link 5 text"
        },
        {
          "type": "url",
          "id": "link_url_5",
          "label": "Link 5 URL"
        },
        {
          "type": "text",
          "id": "link_text_6",
          "label": "Link 6 text"
        },
        {
          "type": "url",
          "id": "link_url_6",
          "label": "Link 6 URL"
        }
      ]
    }
  ]
}
{% endschema %}
