{{- 'section-footer.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign footer_settings = section.settings
  assign has_footer_meta = false
  unless footer_settings.hide_socials
    assign has_footer_meta = true
  endunless
  if footer_settings.menu != blank or footer_settings.copyright != blank
    assign has_footer_meta = true
  endif
-%}

<footer class="brisk-footer">
  {%- if footer_settings.background_image != blank -%}
    <div class="brisk-footer__background">
      {{
        footer_settings.background_image
        | image_url: width: 2880
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2880',
          sizes: '100vw',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="brisk-footer__inner">
    <div class="brisk-footer__content">
      {%- if footer_settings.title != blank or footer_settings.link_text != blank -%}
        <div class="brisk-footer__head">
          {%- if footer_settings.title != blank -%}
            <h2 class="brisk-footer__title">{{ footer_settings.title }}</h2>
          {%- endif -%}

          {%- if footer_settings.link_text != blank and footer_settings.link_url != blank -%}
            <a
              href="{{ footer_settings.link_url }}"
              class="brisk-footer__instagram-button"
              target="_blank"
              rel="noopener"
            >
              {%- render 'icon-instagram' -%}
              <span>{{ footer_settings.link_text }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="brisk-footer__gallery">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="brisk-footer__gallery-item" {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  {% if block.settings.url != blank %}
                    target="_blank"
                    rel="noopener"
                  {% endif %}
                  aria-label="{{ block.settings.image.alt | default: footer_settings.title | escape }}"
                >
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '240, 360, 480, 640, 800',
                      sizes: '(min-width: 1024px) 16vw, (min-width: 768px) 33vw, 50vw',
                      alt: block.settings.image.alt
                  }}
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="brisk-footer__columns">
        <div class="brisk-footer__newsletter">
          {%- if footer_settings.newsletter_title != blank -%}
            <h3 class="brisk-footer__newsletter-title">
              {{ footer_settings.newsletter_title | escape | newline_to_br }}
            </h3>
          {%- endif -%}

          {%- form 'customer', class: 'brisk-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.errors -%}
              <div class="brisk-footer__form-message brisk-footer__form-message--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <p class="brisk-footer__form-message brisk-footer__form-message--success" role="status">
                Thanks for subscribing!
              </p>
            {%- endif -%}

            <div class="brisk-footer__field-wrap">
              <label class="visually-hidden" for="FooterNewsletter-{{ section.id }}">Email</label>
              <input
                id="FooterNewsletter-{{ section.id }}"
                class="brisk-footer__field"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ footer_settings.newsletter_placeholder | default: 'Enter your email here' | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button class="brisk-footer__submit" type="submit" aria-label="Subscribe">
                <span aria-hidden="true"></span>
              </button>
            </div>
          {%- endform -%}
        </div>

        {%- if has_footer_meta -%}
          <div class="brisk-footer__meta">
            {%- unless footer_settings.hide_socials -%}
              <ul class="brisk-footer__socials" role="list">
                {%- assign social_platforms = 'instagram,facebook,twitter,youtube,pinterest,tumblr,tiktok,vimeo' | split: ',' -%}
                {%- for platform in social_platforms -%}
                  {%- assign setting_key = 'social_' | append: platform | append: '_link' -%}
                  {%- if settings[setting_key] != blank -%}
                    <li>
                      <a
                        href="{{ settings[setting_key] }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="{{ platform | capitalize }}"
                      >
                        {%- case platform -%}
                          {%- when 'instagram' -%}{%- render 'icon-instagram' -%}
                          {%- when 'facebook' -%}{%- render 'icon-facebook' -%}
                          {%- when 'twitter' -%}{%- render 'icon-twitter' -%}
                          {%- when 'youtube' -%}{%- render 'icon-youtube' -%}
                          {%- when 'pinterest' -%}{%- render 'icon-pinterest' -%}
                          {%- when 'tumblr' -%}{%- render 'icon-tumblr' -%}
                          {%- when 'tiktok' -%}{%- render 'icon-tiktok' -%}
                          {%- when 'vimeo' -%}{%- render 'icon-vimeo' -%}
                        {%- endcase -%}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endunless -%}

            {%- if footer_settings.menu != blank -%}
              <nav class="brisk-footer__nav" aria-label="Footer">
                <ul role="list">
                  {%- for link in footer_settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}

            {%- if footer_settings.copyright != blank -%}
              <p class="brisk-footer__copyright">
                {{ footer_settings.copyright }}&nbsp;&nbsp;
                <a href="https://www.sleeplessmedia.com/" target="_blank" rel="noopener">Design by Sleepless</a>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Brisk footer",
  "class": "section-brisk-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "hide_socials",
      "label": "Hide socials",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "textarea",
      "id": "copyright",
      "label": "Copyright"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "textarea",
      "id": "newsletter_title",
      "label": "Newsletter title"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "image-link",
      "name": "Image link",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ]
}
{% endschema %}
