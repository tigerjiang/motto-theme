{{ 'section-brand.css' | asset_url | stylesheet_tag }}
<script src="{{ 'brand-image.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}

  #shopify-section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: 0;
  }

  #shopify-section-{{ section.id }} .brand {
    max-width: none;
    padding: 100px 80px;
    background-color: rgb(var(--color-background));
  }

  #shopify-section-{{ section.id }} .section-header {
    margin: 0;
    padding: 0;
    border: 0;
  }

  #shopify-section-{{ section.id }} .section-header__subtitle,
  #shopify-section-{{ section.id }} .section-header__title {
    color: rgb(var(--color-accent));
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 3.2px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .section-header__subtitle::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .brand__wrapper {
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .brand-list {
    min-height: 70px;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .brand-list__item {
    height: 70px;
  }

  #shopify-section-{{ section.id }} .brand-list__item img {
    max-height: 70px;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .brand {
      padding: 80px 10px 60px;
    }

    #shopify-section-{{ section.id }} .section-header__subtitle,
    #shopify-section-{{ section.id }} .section-header__title {
      justify-content: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .brand__wrapper {
      margin-top: 28px;
    }

    #shopify-section-{{ section.id }} .brand-list,
    #shopify-section-{{ section.id }} .brand-list.swiper .swiper-wrapper {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      min-height: 0;
      column-gap: 0;
      row-gap: 28px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .brand-list .brand-list__item {
      flex: 0 0 33.333%;
      width: 33.333%;
      height: 50px;
      padding: 0 !important;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .brand-list .brand-list__item:nth-child(n + 4) {
      flex-basis: 50%;
      width: 50%;
    }

    #shopify-section-{{ section.id }} .brand-list .brand-list__item:nth-child(n + 6) {
      flex-basis: 100%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .brand-list__item img {
      width: auto !important;
      max-width: 100px;
      max-height: 50px;
    }
  }

{%- endstyle -%}

<div class="brand color-{{ section.settings.color_scheme }} background container section-{{ section.id }}-padding">
  {% render 'section-header',
    section_heading: section.settings.section_heading,
    section_subheading: section.settings.subheading,
    section_heading_size: section.settings.section_heading_size,
    section_heading_tag: section.settings.heading_tag,
    dot: section.settings.dot,
    line: section.settings.line
  %}

  <div class="brand__wrapper">
    <ul
      class="
        brand-list {% if section.settings.layout == 'horizontal-carousel' %}swiper js-slider-logos{% endif %}
        brand-list--{{ section.settings.layout }}
      "
      {% if section.settings.layout == 'horizontal-carousel' %}
        data-duration="{{ section.settings.slideshow_speed }}"
      {% endif %}
    >
      {% if section.settings.layout == 'horizontal-carousel' %}<div class="swiper-wrapper">{% endif %}
      {%- for block in section.blocks -%}
        <li
          class="brand-list__item {% if section.settings.layout == 'horizontal-carousel' %}swiper-slide{% endif %}"
          {{ block.shopify_attributes }}
          style="padding: 0 calc({{ section.settings.slides_gap }}px / 2);"
        >
          {%- if block.settings.image != blank -%}
            {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
            <img
              srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
              src="{{ block.settings.image | image_url: width: 400 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="brand__image header__heading-logo {% if block.settings.image_dark == blank %} header__heading-logo-single {% endif %}"
              style="width: {{ block.settings.image_width }}px;"
            >
            <img
              srcset="{{ block.settings.image_dark | image_url: width: block.settings.image_width }}, {{ block.settings.image_dark | image_url: width: image_size_2x }} 2x"
              src="{{ block.settings.image_dark | image_url: width: 400 }}"
              alt="{{ block.settings.image_dark.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image_dark.width }}"
              height="{{ block.settings.image_dark.height }}"
              class="brand__image header__heading-logo--overlay"
              style="width: {{ block.settings.image_width }}px;"
            >
          {%- elsif block.settings.image == blank and block.settings.title == blank -%}
            <h3 style="opacity: 0.5;">Brand</h3>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {% if section.settings.layout == 'horizontal-carousel' %}</div>{% endif %}
    </ul>
  </div>
</div>

