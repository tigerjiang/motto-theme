        {
          "value": "image_right",
          "label": "t:sections.image-with-text.settings.image_position.options__2.label"
        },
        {
          "value": "image_left",
          "label": "t:sections.image-with-text.settings.image_position.options__3.label"
        },
        {
          "value": "image_bottom",
          "label": "t:sections.image-with-text.settings.image_position.options__4.label"
        },
        {
          "value": "image_center",
          "label": "t:sections.image-with-text.settings.image_position.options__5.label"
        }
      ],
      "default": "image_left",
      "label": "t:sections.image-with-text.settings.image_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "default": "left",
      "label": "t:sections.all.content_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options.options__2.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options.options__1.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.heading_1.label"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.image-with-text.settings.media_type.label",
      "info": "t:sections.image-with-text.settings.media_type.info",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "t:sections.image-with-text.settings.media_type.options__1.label"
        },
        {
          "value": "video",
          "label": "t:sections.image-with-text.settings.media_type.options__2.label"
        },
        {
          "value": "external_video",
          "label": "t:sections.image-with-text.settings.media_type.options__3.label"
        }
