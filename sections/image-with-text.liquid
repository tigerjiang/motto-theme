    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.all.video.label",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.media.blocks.media_card.settings.video_url.label",
      "info": "t:sections.media.blocks.media_card.settings.video_url.info",
      "visible_if": "{{ section.settings.media_type == 'external_video' }}"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.video_options.header.content",
      "visible_if": "{{ section.settings.media_type == 'video' or section.settings.media_type == 'external_video' }}"
    },
    {
      "type": "checkbox",
