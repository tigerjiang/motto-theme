{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign color_scheme = section.settings.color_scheme
  assign image_position = section.settings.image_position
  assign image_size = section.settings.image_size
  assign content_alignment = section.settings.content_alignment

  if image_position == 'image_top' or image_position == 'image_bottom'
    assign media_widths = '360, 535, 720, 940, 1070, 1200, 1500, 1780, 2000'
    assign media_sizes = '(min-width: 1100px) calc((100vw - 126px)), calc((100vw - 40px))'
  else
    assign media_widths = '360, 535, 720, 940, 1070, 1200, 1400, 1600'
    assign media_sizes = '(min-width: 1100px) calc((50vw - 64px)), calc((100vw - 40px))'
  endif

  assign video_muted = section.settings.video_muted
  assign video_playsinline = false
  assign video_autoplay = false

  if section.settings.video_autoplay
    assign video_autoplay = true
    assign video_muted = true
    assign video_playsinline = true
  endif
%}

{%- capture image_with_text_media -%}
  {%- case section.settings.media_type -%}
    {%- when 'video' -%}
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1920x',
            autoplay: video_autoplay,
            loop: section.settings.video_loop,
            controls: section.settings.video_controls,
            muted: video_muted,
            playsinline: video_playsinline
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    {%- when 'external_video' -%}
      {%- if section.settings.video_url != blank -%}
        <div class="image-with-text__media-embed">
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1{%- if video_autoplay -%}&autoplay=1{%- else -%}&autoplay=0{%- endif -%}{%- if video_muted -%}&mute=1{%- endif -%}{%- if section.settings.video_controls != true -%}&controls=0{%- endif -%}{%- if section.settings.video_loop -%}&playlist={{ section.settings.video_url.id }}&loop=1{%- endif -%}&playsinline=1&rel=0"
              class="js-youtube"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.video_description | escape }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?{%- if video_autoplay -%}autoplay=1&autopause=0{%- else -%}autoplay=0{%- endif -%}{%- if video_muted -%}&muted=1{%- endif -%}{%- if section.settings.video_controls != true -%}&controls=0{%- endif -%}{%- if section.settings.video_loop -%}&loop=1{%- endif -%}&playsinline=1"
              class="js-vimeo"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ section.settings.video_description | escape }}"
            ></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    {%- else -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: section.settings.image.width
          | image_tag: loading: 'lazy', sizes: media_sizes, widths: media_widths
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
  {%- endcase -%}
{%- endcapture -%}

<div class="image-with-text {% if image_position == 'image_center' %} color-{{ color_scheme }} image-centered-layout {%- else -%} image-standard-layout {% endif %}">
  <div
    class="container"
  >
    <div class="image-with-text__wrapper ">
      {% if image_position == 'image_center' %}
        {% if image_size != 'adapt' %}
          {% style %}
            #shopify-section-{{ section.id }} .image-with-text__media {
              aspect-ratio: {{ image_size }};
            }
          {% endstyle %}
        {% endif %}
        {%- liquid
          assign banner_link = section.settings.button_link
          assign banner_is_linked = false
          if banner_link != blank
            assign banner_is_linked = true
          endif

          if section.settings.heading != blank
            assign banner_link_label = section.settings.heading
          elsif section.settings.button_label != blank
            assign banner_link_label = section.settings.button_label
          else
            assign banner_link_label = 'Banner link'
          endif
        -%}
        <div class="image-with-text__centered{% if image_size == 'adapt' %} centered-adapt{% endif %}{% if banner_is_linked %} image-with-text__centered--linked{% endif %}">
          <div class="image-with-text__content image-with-text__content--{{ content_alignment }}">
            {% render 'section-header',
              section_heading: section.settings.heading,
              section_subheading: section.settings.subheading,
              dot: section.settings.dot,
              section_heading_size: section.settings.heading_size,
              section_heading_tag: section.settings.section_heading_tag,
              line: section.settings.line
            %}

            {% if section.settings.text != blank %}
              <div class="image-with-text__text richtext__content">
                {{ section.settings.text }}
              </div>
            {% endif %}
          </div>

          <div class="image-with-text__media {{ image_size }}">
            {{ image_with_text_media }}
          </div>

          {% if section.settings.button_label != blank %}
            <div class="button-container image-with-text__button-container--{{ content_alignment }}">
              {% if banner_is_linked %}
                <span
                  class="
                    button button--{{ section.settings.button_style }}
                    image-with-text__button
                    {% if section.settings.button_dot %}dot_active{% endif %}
                  "
                >
                  <span>{{ section.settings.button_label | escape }}</span>
                </span>
              {% else %}
                {% render 'button',
                  btn_label: section.settings.button_label,
                  btn_link: section.settings.button_link,
                  btn_style: section.settings.button_style,
                  button_dot: section.settings.button_dot,
                  add_classes: 'image-with-text__button focus-inset'
                %}
              {% endif %}
            </div>
          {%- endif -%}

          {%- if banner_is_linked -%}
            <a
              href="{{ banner_link }}"
              class="image-with-text__banner-link full-unstyled-link"
              aria-label="{{ banner_link_label | escape }}"
            ></a>
          {%- endif -%}
        </div>
      {%- elsif image_position != 'image_center' -%}
        <div class="image-with-text__grid image-with-text__grid--{{ image_position }}">
          {% if image_size != 'adapt' %}
            {% style %}
              #shopify-section-{{ section.id }} .image-with-text__media {
                aspect-ratio: {{ image_size }};
              }
            {% endstyle %}
          {% endif %}
          <div class="image-with-text__media {{ image_size }}">
            {{ image_with_text_media }}
          </div>
          <div class="image-with-text__content color-{{ color_scheme }} image-with-text__content--{{ content_alignment }} image-with-text__content--{{ image_position }}">
            {% render 'section-header',
              section_heading: section.settings.heading,
              section_subheading: section.settings.subheading,
              dot: section.settings.dot,
              section_heading_size: section.settings.heading_size,
              section_heading_tag: section.settings.section_heading_tag,
              line: section.settings.line
            %}

            {% if section.settings.text != blank %}
              <div class="image-with-text__text richtext__content">
                {{ section.settings.text }}
              </div>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <div class="image-with-text__button-wrapper">
                {% render 'button',
                  btn_label: section.settings.button_label,
                  btn_link: section.settings.button_link,
                  btn_style: section.settings.button_style,
                  button_dot: section.settings.button_dot,
                  add_classes: 'image-with-text__button focus-inset'
                %}
              </div>
            {%- endif -%}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
