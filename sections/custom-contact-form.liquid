{%- style -%}
       .section-contact {
          width: 80%; /* 设置宽度为80% */
          margin: 0 auto; /* 上下外边距为0，左右外边距为auto */
          padding: 20px; /* 可选：增加一些内边距 */
          box-sizing: border-box; /* 包含内边距和边框计算在内 */
        }
        .form-field-row {
          display: flex;
         width: 100%;
         justify-content: space-between;
          flex-direction:row;

      }
  .form-field-row > * {
    margin-right: 16px; /* 设置子元素之间的间距 */
  }

  .form-field-row > *:last-child {
    margin-right: 0; /* 最后一个子元素不添加右边距 */
  }
      .column {
      flex: 1;
    }
     .checkbox-group-store {
      margin-top: 10px;
       padding-right:10px;
      flex: 1;
    }
    #hiddenInput-store {
      display: none;
    }

       .contact_desc{
          color: rgb(0,0,0);
        font-family: 'Roboto' !important;
        font-weight:400 !important;
        font-size: 14px;

   }


   .contact_field_layout{
      display: flex;
     margin-top:24px;
     flex-direction: row;
     gap:24px;
   }

     .contact_field_layout a{
        text-decoration: none; /* 去掉下划线 */
       display: flex; /* 使用 flexbox 对齐 */
       align-items: center; /* 垂直居中对齐 */
        color: rgb(41,48,61);
        font-family: 'Roboto' !important;
        font-weight:400 !important;
        font-size: 14px;
        line-height: 24px;
        letter-spacing: 0.14px;
   }

    .radio-group-market {
      margin-top: 10px;
      flex: 1;
      padding-right:10px;
    }
    #hiddenInput-market {
      display: none;
    }
    .checkbox-group-brand {
      margin-top: 10px;
      padding-right:10px;
      flex: 1;
    }
    #hiddenInput-brand {
      display: none;
    }

      .form-field-row label {
        color: rgb(41,48,61);
        font-family: 'Roboto' !important;
        font-weight:400 !important;
        font-size: 14px;
        line-height: 24px;
        letter-spacing: 0.14px;
      }
      .form-field {
        position: relative;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;

        flex: 1 1 auto; /* 使所有表单字段平均分配表单行宽度 */
      }

      .form-field__input {
        font-size: 14px;
        color: rgb(41,48,61);
        padding: 1rem 0.5rem 0.5rem;
        border: none;
        border-bottom: 1px solid #ccc; /* 设置下划线颜色为灰色 */
        width: 100%;
        box-sizing: border-box;
       background-color: transparent; /* 使用transparent来去除背景色 */
        transition: border-color 0.3s, box-shadow 0.3s;
        outline: none;
      }

      .form-area__input {
        font-size: 14px;
        color: rgb(41,48,61);
        padding: 1rem 0.5rem 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.3s, box-shadow 0.3s;
        outline: none;
      }

      .form-area__input:focus,
      .form-area__input:not(:placeholder-shown) {
        border-color:rgb(41,48,61);
        box-shadow: 0 0 1px rgb(41,48,61);
      }

      .form-field__label_title {
        position: absolute;
        top: 50%;
        left: 0.5rem;
        transform: translateY(-50%);
        font-size: 14px;
        pointer-events: none;
        transition: all 0.3s;
        color: rgb(41,48,61);
        font-family: 'Roboto' !important;
        font-weight:400 !important;
      }

      .__label_title {
        color: rgb(41,48,61);
        font-family: 'Roboto' !important;
        font-weight:400 !important;
        font-size: 16px;
        line-height: 24px;
        margin-top: 6px;
        margin-bottom: 6px;
        letter-spacing: 0.16px;
      }





      .form-field__input:focus,
      .form-field__input:not(:placeholder-shown) {
        border-color: rgb(41, 48, 61);
      }

      .form-field__input:focus + .form-field__label_title,
      .form-field__input:not(:placeholder-shown) + .form-field__label_title {
        top: 0;
        transform: translateY(-100%);
        font-size: 12px;
        color: rgb(41,48,61);
      }
      /* 使多选下拉列表更美观 */
      .form-field__input[multiple] {
        height: auto;
        padding: 1rem;
        cursor: pointer;
      }
      /* 可选：为小屏幕设备调整布局 */
      @media (max-width: 768px) {
        .form-field-row {
          display: flex;
          flex-direction: column;
      }
          .form-field-row > * {
    margin-right: 0px; /* 设置子元素之间的间距 */
  }

  .form-field-row > *:last-child {
    margin-right: 0; /* 最后一个子元素不添加右边距 */
  }
           .contact_field_layout{
      display: flex;
     margin-top:24px;
             flex-direction: column;
   }
      }
{%- endstyle -%}
<section
  class="section-contact"
  style="background-size: cover;background-repeat: no-repeat;background-position: top center;"
>
  <div class="shell">
    <div
      style="font-size: 30px;width: 100%;text-align: left;font-family:'Roboto' !important;color: rgb(41,48,61)"
    >
      Contact Us
    </div>
    {%- if section.settings.description != blank -%}
      <div style="margin-top:24px;margin-bottom:24px;font-family:'Roboto' !important;font-weight:400 !important;color:#29303d">
        {{- section.settings.description -}}
      </div>
    {%- endif -%}
    <div class="contact_field_layout">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{- section.settings.phone | replace: ' ', '' -}}" class="hero__btn">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M6.6 2.5h3l1.5 5-2.1 1.5a15.2 15.2 0 0 0 6 6l1.5-2.1 5 1.5v3c0 2.2-1.8 4-4 4A15 15 0 0 1 2.6 6.5c0-2.2 1.8-4 4-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>

          <span>{{- section.settings.phone -}}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <a href="mailto:{{- section.settings.email -}}" class="hero__btn">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="m4 6 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          <span>{{- section.settings.email -}}</span>
        </a>
      {%- endif -%}
    </div>
    <!-- /.hero__actions -->
    <div
      style="font-size:14px;width:100%;text-align:right;margin-top:24px;font-family:'Roboto' !important;color:rgb(41,48,61)"
    >
      Required*
    </div>
    {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {% render 'icon-success' %}
          Thanks for contacting us. We'll get back to you as soon as possible.
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2
            class="form-status caption-large text-body"
            role="alert"
            style="max-height:44px !important"
            tabindex="-1"
            autofocus
          >
            {% render 'icon-error' %}
            Please adjust the following:
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
          <li>
            <a href="#first-name" class="link">
              {{- form.errors.translated_fields.first_name | capitalize }}
              {{ form.errors.messages.first_name -}}
            </a>
          </li>
        </ul>
      {%- endif -%}

      <div class="form-field-row" style="margin-top: 24px;">
        <div class="form-field">
          <input
            type="text"
            id="first-name"
            name="contact[first_name]"
            class="form-field__input"
            placeholder=" "
            value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            required
          >
          <label for="first-name" class="form-field__label_title">
            First Name
            <span aria-hidden="true">*</span></label
          >
        </div>

        <div class="form-field">
          <input
            type="text"
            id="email"
            name="contact[email]"
            class="form-field__input"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder=" "
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
          >
          <label for="email" class="form-field__label_title">
            Email
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
        <div class="form-field">
          <input
            type="text"
            id="phone"
            name="contact[phone]"
            class="form-field__input"
            placeholder=" "
            pattern="[0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          >
          <label for="phone" class="form-field__label_title">Phone Number</label>
        </div>
      </div>
      <div class="form-field-row">
        <div class="form-field">
          <input
            type="text"
            id="city"
            name="contact[city]"
            class="form-field__input"
            placeholder=" "
            value="{% if form.city %}{{ form.city }}{% elsif customer %}{{ customer.city }}{% endif %}"
            required
          >
          <label for="city" class="form-field__label_title">City*</label>
        </div>
        <div class="form-field">
          <input
            type="text"
            id="country"
            name="contact[country]"
            class="form-field__input"
            placeholder=" "
            value="{% if form.country %}{{ form.country }}{% elsif customer %}{{ customer.country }}{% endif %}"
            required
          >
          <label for="country" class="form-field__label_title">Country*</label>
        </div>
        <div class="form-field">
          <input
            type="text"
            id="province"
            name="contact[province]"
            class="form-field__input"
            placeholder=" "
            value="{% if form.province %}{{ form.province }}{% elsif customer %}{{ customer.province }}{% endif %}"
            required
          >
          <label for="province" class="form-field__label_title">State/Province*</label>
        </div>
      </div>

      <div class="form-field">
        <input
          type="text"
          id="subject"
          name="contact[subject]"
          class="form-field__input"
          placeholder=" "
          value="{% if form.subject %}{{ form.subject }}{% elsif customer %}{{ customer.subject }}{% endif %}"
          required
        >
        <label for="subject" class="form-field__label_title">Subject*</label>
      </div>

      <div class="form-field">
        <label class="__label_title" style="display:block;margin-bottom:10px;" for="message">Message</label>
        <textarea
          id="message"
          class="form-area__input"
          rows="10"
          cols="50"
          name="contact[message]"
          placeholder="Message"
        >{% if form.message %}{{ form.message }}{% endif %}</textarea
        ><br>
        <br>
        <!-- /.cols cols-/-section -->
        <div class="contact__button">
          <button type="submit" id="submitButton" class="btn btn--primary btn--red">
            <span> Submit</span>
          </button>
        </div>
      </div>
    {%- endform -%}
  </div>
</section>

{% javascript %}

  document.getElementById('submitButton').addEventListener('click', function (event) {
    // 检查必填字段
    const requiredFields = ['first-name', 'email', 'city', 'country', 'province', 'subject'];
    for (let field of requiredFields) {
      const input = document.getElementById(field);
      if (!input.value.trim()) {
        // alert(`Please fill out the required field: ${field}`);
        return;
      }
    }
   });
{% endjavascript %}
{% schema %}
{
  "name": "Contact Us",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Add comments for collecting user information and how long it will take to reply to customers"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    }
  ]
}
{% endschema %}
