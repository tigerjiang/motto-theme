{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<section class="hiw-section hiw-split">
  <div class="hiw-container hiw-split__grid">
    <div class="hiw-split__content">
      <h2 class="hiw-title">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- if section.settings.text != blank -%}<div class="hiw-copy">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="hiw-media hiw-split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '540, 750, 1000, 1300, 1600, 1800, 2000', sizes: '(min-width: 1920px) 880px, (min-width: 750px) 60vw, calc(100vw - 32px)', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hiw-placeholder placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Juggling life",
  "tag": "section",
  "class": "hiw-juggling-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Juggling life? AI adapts, so you don’t have to." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>AI is constantly monitoring your grill and adapting to unexpected events to make sure that nothing is overcooked or ruined.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Juggling life" }]
}
{% endschema %}
