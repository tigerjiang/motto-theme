{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<section class="hiw-section hiw-learn">
  <div class="hiw-container hiw-learn__layout">
    <div class="hiw-learn__copy">
      <h2 class="hiw-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="hiw-copy">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="hiw-learn__track" aria-label="{{ section.settings.slider_label | escape }}">
      {%- for block in section.blocks -%}
        <div class="hiw-media hiw-learn__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280, 420, 560, 700', sizes: '(min-width: 750px) 22vw, 72vw', alt: block.settings.image_alt }}
          {%- else -%}
            {{ 'product-2' | placeholder_svg_tag: 'hiw-placeholder placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AI learns",
  "tag": "section",
  "class": "hiw-learn-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brisk It AI Learns With Every Cook." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Brisk It AI learns your preferences and cooking behavior, optimizing future cooks and creating new, relevant recipes for you to try.</p>" },
    { "type": "text", "id": "slider_label", "label": "Slider accessibility label", "default": "AI cooking insights" }
  ],
  "blocks": [{
    "type": "slide", "name": "App screen",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Brisk It app insight screen" }
    ]
  }],
  "presets": [{ "name": "AI learns", "blocks": [{"type":"slide"},{"type":"slide"},{"type":"slide"}] }]
}
{% endschema %}
