{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}

<div class="collapsible-content section-{{ section.id }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  <div class="container">
    <div class="collapsible-content__wrapper {% if section.settings.section_layout == "column" %} column-direction{% endif %}">
      <div>
        {% render 'section-header',
          section_heading: section.settings.section_heading,
          section_subheading: section.settings.section_subheading,
          dot: section.settings.dot,
          section_heading_size: section.settings.section_heading_size,
          section_heading_tag: section.settings.section_heading_tag
        %}
      </div>

      <div class="collapsible-content-main-container">
        <div class="collapsible-content__content">
          <div class="collapsible-content__items">
            {%- for block in section.blocks -%}
              <div
                class="collapsible-content__item{% if block.settings.default_open %} active{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button
                  class="collapsible-content__toggle focus-inset button--unstyled"
                  aria-label="{{ block.settings.question | escape }}"
                >
                  <div class="collapsible-content__toggle-group">
                    {%- if block.settings.question != blank -%}
                      {% assign collapse_heading_tag = section.settings.collapse_heading_tag %}
                      <{{ collapse_heading_tag }} class="collapsible-content__question h4 font-weight-medium">
                        {{ block.settings.question | escape }}
                      </{{ collapse_heading_tag }}>
                    {%- endif -%}
                  </div>
                  <div class="collapsible-content__icon icon-style--{{ section.settings.icon_style }}">
                    {% render 'icon-minus' %}
                    {% render 'icon-plus' %}
                  </div>
                </button>

                {%- if block.settings.answer != blank or block.settings.item_image_1 != blank or block.settings.item_image_2 != blank or block.settings.item_image_3 != blank -%}
                  <div
                    class="collapsible-content__answer"
                    {% if block.settings.default_open %}
                      style="display: block;"
                    {% endif %}
                  >
                    <div class="collapsible-content__answer-inner richtext__content">
                      {%- if block.settings.answer != blank -%}
                        {{ block.settings.answer }}
                      {%- endif -%}
                      {%- if block.settings.item_image_1 != blank or block.settings.item_image_2 != blank or block.settings.item_image_3 != blank -%}
                        <div class="collapsible-content__media-list">
                          {%- for index in (1..3) -%}
                            {%- liquid
                              assign image_key = 'item_image_' | append: index
                              assign heading_key = 'item_heading_' | append: index
                              assign text_key = 'item_text_' | append: index
                              assign item_image = block.settings[image_key]
                              assign item_heading = block.settings[heading_key]
                              assign item_text = block.settings[text_key]
                            -%}
                            {%- if item_image != blank or item_heading != blank or item_text != blank -%}
                              <article class="collapsible-content__media-item">
                                {%- if item_image != blank -%}
                                  <div class="collapsible-content__media-image">
                                    {{
                                      item_image
                                      | image_url: width: 720
                                      | image_tag:
                                        loading: 'lazy',
                                        widths: '180, 240, 360, 540, 720',
                                        sizes: '(min-width: 750px) 28rem, 12rem'
                                    }}
                                  </div>
                                {%- endif -%}
                                <div class="collapsible-content__media-copy">
                                  {%- if item_heading != blank -%}
                                    <h4 class="collapsible-content__media-heading">{{ item_heading | escape }}</h4>
                                  {%- endif -%}
                                  {%- if item_text != blank -%}
                                    <div class="collapsible-content__media-text">{{ item_text }}</div>
                                  {%- endif -%}
                                </div>
                              </article>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="faq-button-container">
          {% render 'button',
            btn_label: section.settings.section_button_label,
            btn_link: section.settings.section_button_link,
            btn_style: section.settings.section_button_style,
            button_dot: section.settings.button_dot,
            add_classes: 'focus-inset'
          %}
        </div>
      </div>
    </div>
  </div>
</div>

