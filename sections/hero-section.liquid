{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

{%- style -%}
  body:has(#shopify-section-{{ section.id }} .hiw-hero) > .breadcrumbs-wrapper {
    display: none;
  }

  #shopify-section-{{ section.id }} .hiw-hero {
    --hiw-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hiw-hero-position: {{ section.settings.image_position }};
  }
{%- endstyle -%}

<section class="hiw-section hiw-hero">
  <div class="hiw-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank or section.settings.mobile_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
        {%- endif -%}
        {%- assign hero_image = section.settings.image | default: section.settings.mobile_image -%}
        {{ hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: '' }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="hiw-hero__overlay"></div>
  <div class="hiw-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="hiw-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="hiw-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.text != blank -%}<div class="hiw-hero__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="hiw-hero__button">
        {% render 'button',
          btn_label: section.settings.button_label,
          btn_link: section.settings.button_link,
          btn_style: 'primary',
          add_classes: 'hiw-hero__button-link focus-inset'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works hero",
  "tag": "section",
  "class": "hiw-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "center", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AI COOKING" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooking Made Simpler" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Brisk It makes your cooking experience simpler with the power of AI.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Products" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "How it works hero" }]
}
{% endschema %}
