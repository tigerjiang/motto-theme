{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

<section class="hiw-section hiw-hands">
  <div class="hiw-container">
    <h2 class="hiw-title hiw-hands__title">{{ section.settings.heading | escape }}</h2>
    <ol class="hiw-hands__grid">
      {%- for block in section.blocks -%}
        <li class="hiw-hands__step" data-step="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="hiw-media hiw-hands__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, calc(100vw - 32px)', alt: block.settings.heading }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hiw-placeholder placeholder-svg' }}
            {%- endif -%}
          </div>
          <h3 class="hiw-hands__heading">{{ block.settings.heading | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="hiw-hands__text">{{ block.settings.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Hands-free steps",
  "tag": "section",
  "class": "hiw-hands-section",
  "max_blocks": 3,
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Simple, effortless, automated, and hands-free." }],
  "blocks": [{
    "type": "step", "name": "Step",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Step heading" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe this step.</p>" }
    ]
  }],
  "presets": [{
    "name": "Hands-free steps",
    "blocks": [
      { "type": "step", "settings": { "heading": "Tell Brisk It What You Need", "text": "<p>Health goals, cravings, or a photo of your ingredients — Brisk It AI learns it all and builds a recipe around you.</p>" } },
      { "type": "step", "settings": { "heading": "Prep with AI-Powered Guidance", "text": "<p>Smart ingredients, prep steps, and cooking instructions are laid out for you. Brisk It guides your every move.</p>" } },
      { "type": "step", "settings": { "heading": "Let Full-Self Cooking Take Over", "text": "<p>Place your food on the device. Brisk It monitors, adjusts, and controls heat in real time — from ignition to perfect doneness.</p>" } }
    ]
  }]
}
{% endschema %}
