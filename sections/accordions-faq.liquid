{{- 'section-brisk-pages.css' | asset_url | stylesheet_tag -}}

<section class="brisk-faq color-{{ section.settings.color_scheme }} background">
  <div class="brisk-faq__inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'title' -%}
          {%- if block.settings.title != blank -%}
            <h2 class="brisk-faq__heading" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
          {%- endif -%}
        {%- when 'accordion' -%}
          {%- if block.settings.title != blank -%}
            <details class="brisk-faq__item" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="brisk-faq__answer rte">{{ block.settings.text }}</div>
            </details>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordions",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "settings": [{ "type": "text", "id": "title", "label": "Title" }]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ accordions" }]
}
{% endschema %}
