<link
  rel="stylesheet"
  href="{{ 'component-badge.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<link
  rel="stylesheet"
  href="{{ 'component-card.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<link
  rel="stylesheet"
  href="{{ 'component-price.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<link
  rel="stylesheet"
  href="{{ 'section-product-recommendations.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{{ 'section-product-slider.css' | asset_url | stylesheet_tag }}

<noscript>{{ 'component-badge.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>
  {{- 'section-product-recommendations.css' | asset_url | stylesheet_tag -}}
</noscript>

{%- if settings.quickview_show or settings.show_on_mobile or settings.type_color_swatch == 'custom' -%}
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if settings.quickview_show or settings.show_on_mobile -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag: preload: true }}
{%- endif -%}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}

{% liquid
  assign section_id = 'shopify-section-' | append: section.id
%}

<product-recommendations
  class="popular-products popular-products--recommendations section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} background"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}"
  data-id="{{ section_id }}"
>
  <div class="container">
    {% render 'section-header',
      section_heading: section.settings.section_heading,
      section_subheading: section.settings.subheading,
      section_heading_size: section.settings.section_heading_size,
      section_heading_tag: section.settings.section_heading_tag,
      dot: section.settings.dot,
      line: section.settings.line
    %}
    <div class="popular-product__wrapper"></div>
  </div>
  {% if recommendations.performed and recommendations.products_count > 0 %}
    {% liquid
      assign per_row = section.settings.columns_per_row
      if recommendations.products_count <= section.settings.columns_per_row or section.settings.products_limit <= section.settings.columns_per_row
        assign show_arrows = false
      else
        assign show_arrows = section.settings.show_arrows
      endif
    %}
    {% render 'products-swiper',
      slider_settings: section.settings,
      product_list: recommendations.products,
      product_count: recommendations.products_count,
      section_id: section_id,
      container: section.settings.layout,
      per_row: per_row,
      show_arrows: show_arrows,
      show_rating: true
    %}
  {% else %}
    <div
      class="product-recommendations__empty container"
      style="display: none;"
    >
      <span>
        {{ 'sections.product_recommendations.recommendations_empty' | t }}
      </span>
    </div>
  {% endif %}

  <div
    class="product-recommendations__loading"
    style="display: none;"
  >
    {% render 'icon-spinner' %}
  </div>
</product-recommendations>

