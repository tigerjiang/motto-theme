{%- liquid
  assign mod_section = mod_section | default: section
  assign mod_class = mod_class | default: false
  assign mod_title = mod_title | default: false
  assign mod_text = mod_text | default: false
  assign mod_image = mod_image | default: false
  assign hero_settings = mod_section.settings
  assign desktop_image = mod_image | default: hero_settings.image_desktop | default: hero_settings.image_mobile
  assign mobile_image = hero_settings.image_mobile | default: desktop_image
  assign content_block = mod_section.blocks.first

  if content_block != blank
    assign content_settings = content_block.settings
    assign hero_title = mod_title | default: content_settings.heading
    assign hero_text = mod_text | default: content_settings.text
    assign button_first_text = content_settings.button_label
    assign button_first_url = content_settings.button_link
    assign button_first_style = content_settings.button_style
    assign button_first_dot = content_settings.button_dot
    assign button_second_text = content_settings.button_label_2
    assign button_second_url = content_settings.button_link_2
    assign button_second_style = content_settings.button_style_2
    assign button_second_dot = content_settings.button_dot_2
    assign text_width = content_settings.text_width
  else
    assign hero_title = mod_title | default: hero_settings.title
    assign hero_text = mod_text | default: hero_settings.text
    assign button_first_text = hero_settings.button_first_text
    assign button_first_url = hero_settings.button_first_url
    assign button_first_style = 'primary'
    assign button_second_text = hero_settings.button_second_text
    assign button_second_url = hero_settings.button_second_url
    assign button_second_style = 'secondary'
    assign text_width = 'large'
  endif

  assign heading_tag = hero_settings.heading_tag | default: 'h1'
-%}

{%- if hero_settings.video != blank or desktop_image != blank -%}
  <div class="hero{% if mod_class %} {{ mod_class }}{% endif %}">
    <div class="hero__background image-fit" aria-hidden="true">
      {%- if hero_settings.video != blank -%}
        <div class="video-background hero__video">
          {%- if hero_settings.video.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ hero_settings.video.id }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ hero_settings.video.id }}&playsinline=1&rel=0"
              title="Background video"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="eager"
              tabindex="-1"
            ></iframe>
          {%- elsif hero_settings.video.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ hero_settings.video.id }}?background=1&autoplay=1&muted=1&loop=1&byline=0&title=0&controls=0"
              title="Background video"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="eager"
              tabindex="-1"
            ></iframe>
          {%- endif -%}
        </div>
      {%- else -%}
        <picture>
          {%- unless mod_image -%}
            {%- if hero_settings.image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ mobile_image | image_url: width: 1000 }}"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
              >
            {%- endif -%}
          {%- endunless -%}
          {{
            desktop_image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 1920, 2400',
              sizes: '100vw',
              alt: desktop_image.alt
          }}
        </picture>
      {%- endif -%}
    </div>

    {%- if hero_title != blank
      or hero_text != blank
      or button_first_text != blank
      or button_second_text != blank
      or hero_settings.badge != blank
      or content_settings.eyebrow != blank
    -%}
      <div class="hero__inner hero2__inner">
        <div class="hero__shell">
          <div
            class="hero__content hero__content--left hero__content--{{ text_width }}{% if hero_settings.text_animation %} hero__content--animation{% endif %}"
            {% if content_block != blank %}{{ content_block.shopify_attributes }}{% endif %}
          >
            {%- if hero_settings.badge != blank -%}
              <div class="hero__badge">
                {{
                  hero_settings.badge
                  | image_url: width: 500
                  | image_tag:
                    loading: 'eager',
                    widths: '160, 240, 320, 500',
                    sizes: '(max-width: 749px) 160px, 250px',
                    alt: hero_settings.badge.alt
                }}
              </div>
            {%- endif -%}

            {%- if content_settings.eyebrow != blank -%}
              <p class="hero__eyebrow{% if hero_settings.text_animation %} js-fade{% endif %}">
                {{ content_settings.eyebrow | escape }}
              </p>
            {%- endif -%}

            {%- if hero_title != blank -%}
              <header class="hero__head">
                <{{ heading_tag }}
                  class="hero__title hero__title--large{% if hero_settings.text_animation %} js-split-text{% endif %}"
                  dir="ltr"
                >
                  {{ hero_title }}
                </{{ heading_tag }}>
              </header>
            {%- endif -%}

            {%- if hero_text != blank -%}
              <div class="hero__body rte{% if hero_settings.text_animation %} js-fade{% endif %}">
                {{ hero_text }}
              </div>
            {%- endif -%}

            {%- if button_first_text != blank or button_second_text != blank -%}
              <div class="hero__footer{% if hero_settings.text_animation %} js-fade{% endif %}">
                <div class="hero__actions">
                  {%- if button_first_text != blank -%}
                    {% render 'button',
                      btn_label: button_first_text,
                      btn_link: button_first_url,
                      btn_style: button_first_style,
                      button_dot: button_first_dot,
                      add_classes: 'hero__button hero__button--first focus-inset'
                    %}
                  {%- endif -%}

                  {%- if button_second_text != blank -%}
                    {% render 'button',
                      btn_label: button_second_text,
                      btn_link: button_second_url,
                      btn_style: button_second_style,
                      button_dot: button_second_dot,
                      add_classes: 'hero__button hero__button--second focus-inset'
                    %}
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
